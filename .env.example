POSTGRES_PASSWORD=replace-with-random-secret
GATEWAY_DB_PASSWORD=replace-with-random-secret
ACCOUNTS_DB_PASSWORD=replace-with-random-secret
LEDGER_DB_PASSWORD=replace-with-random-secret
PAYMENTS_DB_PASSWORD=replace-with-random-secret
NOTIFICATION_DB_PASSWORD=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
ACCOUNTS_SERVICE_TOKEN=replace-with-random-secret
PAYMENTS_SERVICE_TOKEN=replace-with-random-secret
DEMO_FUNDING_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
RISK_MINUTE_LIMIT=10
RISK_DAILY_LIMIT=10000000
TOPUP_LIMIT=1000000
GATEWAY_RATE_LIMIT=120

# Optional IDE-only overrides. Compose supplies container addresses explicitly.
# PORT: gateway 8080, accounts 8081, ledger 8082, payments 8083, notifications 8084
# DB_URL=jdbc:postgresql://localhost:5432/<accounts|ledger|payments|notification>_db
# DB_USER=<accounts|ledger|payments|notification>
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# ACCOUNTS_URL=http://localhost:8081
# LEDGER_URL=http://localhost:8082
# PAYMENTS_URL=http://localhost:8083
# NOTIFICATIONS_URL=http://localhost:8084
# BASE_URL=http://localhost:8080  # k6 target only
